---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import PersistentPlayer from '../components/AudioPlayer';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Eternal Heart — Music for the Heart, Nervous System & Soul',
  description = "Cameron Gaut creates ambient music, bansuri flute meditations, music therapy journeys, and immersive sonic experiences from the spirit of Kauaʻi.",
  image = '/og-image.jpg',
} = Astro.props;

const siteUrl = 'https://eternalheartmusic.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

const audioDir = join(process.cwd(), 'public', 'audio');
const allowedExts = new Set(['.mp3', '.m4a', '.wav', '.ogg', '.aac', '.flac']);
const allAudioFiles = readdirSync(audioDir, { withFileTypes: true })
  .filter((e) => e.isFile())
  .map((e) => e.name)
  .filter((n) => { const d = n.lastIndexOf('.'); return d >= 0 && allowedExts.has(n.slice(d).toLowerCase()); })
  .sort((a, b) => a.localeCompare(b));
const preferred = 'radiance.mp3';
const audioTracks = allAudioFiles.includes(preferred)
  ? [`/audio/${preferred}`, ...allAudioFiles.filter((n) => n !== preferred).map((n) => `/audio/${n}`)]
  : allAudioFiles.map((n) => `/audio/${n}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Eternal Heart" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${title} — Eternal Heart`} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${title} — Eternal Heart`} />

    <link rel="icon" type="image/svg+xml" href="/logomark.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MusicGroup",
      "name": "Eternal Heart",
      "alternateName": "Cameron Gaut",
      "url": siteUrl,
      "image": ogImage,
      "description": "Cameron Gaut creates ambient music, bansuri flute meditations, music therapy journeys, and immersive sonic experiences from the spirit of Kauaʻi.",
      "genre": ["Ambient", "World Music", "Meditation", "New Age"],
      "sameAs": [
        "https://open.spotify.com/artist/5hJwEvmHfjZ48gTq6BAt3x",
        "https://music.apple.com/us/artist/eternal-heart/308361271",
        "https://www.youtube.com/@eternal-heart-music",
        "https://instagram.com/eternal.heart.music"
      ]
    })} />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <PersistentPlayer tracks={audioTracks} client:only="react" transition:persist transition:name="persistent-player" />
    <slot />

    <script>
      // ── Scroll Reveal — re-runs on every page navigation ──
      function initReveal() {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -48px 0px' }
        );

        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            // iOS Safari can delay IntersectionObserver callbacks for already-visible
            // elements by many seconds. Bypass the observer for anything already on screen.
            // Double-RAF lets the browser paint the initial opacity:0 state first so
            // the CSS transition still plays.
            requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('visible')));
          } else {
            revealObserver.observe(el);
          }
        });
      }

      // ── Nav Scroll Behaviour ───────────────────────────────
      function initNav() {
        const nav = document.getElementById('site-nav');
        if (!nav) return;
        const onScroll = () => {
          nav.classList.toggle('nav--scrolled', window.scrollY > 64);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // astro:page-load fires after every navigation (and on initial load)
      document.addEventListener('astro:page-load', () => {
        initReveal();
        initNav();
      });
    </script>
  </body>
</html>
