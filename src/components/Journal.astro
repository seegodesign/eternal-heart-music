---
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const slugFromEntryId = (id: string) => id.replace(/\.md$/i, '');
---

<section class="section journal" id="journal">
  <div class="container">
    <div class="journal__header reveal">
      <span class="eyebrow">Field Notes</span>
      <h2 class="section-title">
        Thoughts from the<br /><em>practice.</em>
      </h2>
      <div class="divider"></div>
      <p class="section-body">
        Reflections on healing through sound, the nervous system, the creative process,
        and life spent listening to what wants to emerge.
      </p>
    </div>

    <div class="journal__grid">
      {
        posts.map((post, i) => (
          <article class={`journal-card reveal reveal-delay-${i + 1}`}>
            <div class="journal-card__img">
              {
                post.data.coverImage ? (
                  <img
                    src={post.data.coverImage}
                    alt={post.data.title}
                    class="journal-card__cover"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class={`journal-card__img-inner journal-card__img-inner--${post.data.gradient}`} aria-hidden="true"></div>
                )
              }
              <span class="journal-card__cat">{post.data.category}</span>
            </div>
            <div class="journal-card__body">
              <h3 class="journal-card__title">{post.data.title}</h3>
              <p class="journal-card__excerpt">{post.data.excerpt}</p>
              <div class="journal-card__footer">
                <span class="journal-card__read">{post.data.readTime ?? '5 min read'}</span>
                <a href={`/journal/${slugFromEntryId(post.id)}`} class="journal-card__link">
                  Read →
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="journal__more reveal">
      <a href="/journal" class="btn btn--ghost">View all field notes</a>
    </div>
  </div>
</section>

<style>
  .journal__header {
    max-width: 640px;
    margin-bottom: 64px;
  }

  /* ── Grid ─────────────────────────────────────────────────── */
  .journal__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }

  /* ── Card ─────────────────────────────────────────────────── */
  .journal-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    overflow: hidden;
    transition: border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
  }
  .journal-card:hover {
    border-color: var(--color-border-hi);
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
  }

  /* Image area */
  .journal-card__img {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0d0c0d;
  }
  .journal-card__img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 7, 8, 0.55) 0%, rgba(8, 7, 8, 0.06) 65%);
    pointer-events: none;
  }
  .journal-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .journal-card:hover .journal-card__cover {
    transform: scale(1.04);
  }
  .journal-card__img-inner {
    position: absolute;
    inset: 0;
    transition: transform 0.6s ease;
  }
  .journal-card:hover .journal-card__img-inner {
    transform: scale(1.04);
  }

  /* Gradient themes */
  .journal-card__img-inner--amber {
    background:
      radial-gradient(ellipse 80% 80% at 25% 35%, rgba(165, 95, 30, 0.55) 0%, transparent 65%),
      #110e0b;
  }
  .journal-card__img-inner--sage {
    background:
      radial-gradient(ellipse 80% 80% at 60% 40%, rgba(44, 72, 38, 0.55) 0%, transparent 65%),
      #0c0f0c;
  }
  .journal-card__img-inner--ocean {
    background:
      radial-gradient(ellipse 80% 80% at 40% 60%, rgba(20, 45, 70, 0.55) 0%, transparent 65%),
      #0b0d10;
  }

  .journal-card__cat {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(232, 220, 200, 0.75);
    background: rgba(9, 8, 10, 0.55);
    padding: 4px 10px;
    border-radius: 20px;
    backdrop-filter: blur(6px);
    z-index: 2;
  }

  /* Card body */
  .journal-card__body {
    padding: 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .journal-card__title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-cream);
    line-height: 1.35;
    letter-spacing: 0.01em;
  }
  .journal-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--color-cream-dim);
    margin-bottom: 14px;
    flex: 1;
  }
  .journal-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }
  .journal-card__read {
    font-size: 11px;
    font-family: var(--font-sans);
    color: var(--color-cream-muted);
    letter-spacing: 0.08em;
  }
  .journal-card__link {
    font-size: 12px;
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--color-amber);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.2s ease;
  }
  .journal-card__link:hover { color: var(--color-amber-light); }

  /* ── More button ──────────────────────────────────────────── */
  .journal__more { display: flex; }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 900px) {
    .journal__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .journal__grid { grid-template-columns: 1fr; }
  }
</style>
