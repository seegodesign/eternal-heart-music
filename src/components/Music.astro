---
import { getCollection } from "astro:content";

const releases = (await getCollection("releases")).filter(r => r.data.showOnHomepage);

const platforms = [
  {
    name: "Spotify",
    icon: "/icons/spotify.svg",
    href: "https://open.spotify.com/artist/5hJwEvmHfjZ48gTq6BAt3x",
  },
  {
    name: "Apple Music",
    icon: "/icons/apple-music.svg",
    href: "https://music.apple.com/us/artist/eternal-heart/308361271",
  },
  {
    name: "YouTube",
    icon: "/icons/youtube.svg",
    href: "https://www.youtube.com/@eternal-heart-music",
  },
  {
    name: "Bandcamp",
    icon: "/icons/bandcamp.svg",
    href: "https://bandcamp.com/search?q=Cameron%20Gaut",
  },
];
---

<section class="section music" id="music">
  <div class="sep"></div>

  <div class="container">
    <!-- Header -->
    <div class="music__header reveal">
      <span class="eyebrow">Sonic Worlds</span>
      <h2 class="section-title">
        Music to <em>dissolve</em><br />
        the noise of the world.
      </h2>
      <div class="divider"></div>
      <p class="section-body">
        Each recording is a doorway — crafted to slow the breath, soften the
        mind, and open the heart. Drawn from bansuri flute meditation, ambient
        layering, and the living soundscape of Kauaʻi.
      </p>
    </div>

    <!-- Album grid -->
    <div class="music__grid">
      {
        releases.map((r, i) => (
          <article class={`music-card card reveal reveal-delay-${i + 1}`}>
            <div class={`music-card__art music-card__art--${r.data.hue}`}>
              <img
                src={r.data.artwork}
                alt={`${r.data.title} cover artwork`}
                class="music-card__art-inner"
                loading="lazy"
                decoding="async"
              />
              <div class="music-card__meta">
                <span class="music-card__type">{r.data.type}</span>
                <span class="music-card__year">{r.data.year}</span>
              </div>
            </div>
            <div class="music-card__body">
              <h3 class="music-card__title">{r.data.title}</h3>
              <p class="music-card__desc">{r.data.description}</p>
              <div class="music-card__actions">
                <a
                  href={r.data.spotify}
                  class="music-card__link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${r.data.title} on Spotify`}
                >
                  Spotify
                </a>
                <span class="music-card__link-sep" aria-hidden="true">
                  ·
                </span>
                <a
                  href={r.data.bandcamp}
                  class="music-card__link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Buy ${r.data.title} on Bandcamp`}
                >
                  Bandcamp
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="music__discography-cta reveal reveal-delay-2">
      <a href="/music" class="btn btn--ghost">View Discography</a>
    </div>

    <!-- Platforms -->
    <div class="music__platforms reveal reveal-delay-4">
      <p class="music__platforms-label">Stream &amp; download</p>
      <div class="music__platform-list">
        {
          platforms.map((p) => (
            <a
              href={p.href}
              class="platform-btn"
              aria-label={p.name}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span
                class="platform-btn__icon"
                aria-hidden="true"
                style={`--platform-icon-url: url(${p.icon})`}
              />
              <span>{p.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section header ──────────────────────────────────────── */
  .music__header {
    max-width: 680px;
    margin-bottom: 72px;
  }

  /* ── Album grid ───────────────────────────────────────────── */
  .music__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .music__discography-cta {
    width: 100%;
    display: flex;
    justify-content: center;
    text-align: center;
    margin-bottom: 56px;
  }

  /* ── Card ─────────────────────────────────────────────────── */
  .music-card {
    display: flex;
    flex-direction: column;
    cursor: default;
  }

  /* Artwork area */
  .music-card__art {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .music-card__art-inner {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .music-card:hover .music-card__art-inner {
    transform: scale(1.04);
  }

  /* Colour themes per release */
  .music-card__art--amber .music-card__art-inner {
    filter: saturate(0.92) contrast(1.02) brightness(0.9);
  }
  .music-card__art--ocean .music-card__art-inner {
    filter: saturate(0.95) contrast(1.04) brightness(0.9);
  }
  .music-card__art--sage .music-card__art-inner {
    filter: saturate(0.9) contrast(1.03) brightness(0.9);
  }

  .music-card__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 8, 10, 0.36),
      rgba(9, 8, 10, 0.08)
    );
    pointer-events: none;
  }

  /* Meta overlay */
  .music-card__meta {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    gap: 10px;
    align-items: center;
    z-index: 2;
  }
  .music-card__type {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(232, 220, 200, 0.7);
    background: rgba(9, 8, 10, 0.55);
    padding: 4px 10px;
    border-radius: 20px;
    backdrop-filter: blur(6px);
  }
  .music-card__year {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    color: rgba(232, 220, 200, 0.45);
    letter-spacing: 0.1em;
  }

  /* Card body */
  .music-card__body {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .music-card__title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--color-cream);
    letter-spacing: 0.01em;
  }
  .music-card__desc {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--color-cream-dim);
  }
  .music-card__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding-top: 14px;
  }
  .music-card__link-sep {
    color: var(--color-cream-muted);
    font-size: 11px;
    line-height: 1;
    user-select: none;
  }
  .music-card__link {
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-amber);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .music-card__link:hover {
    color: var(--color-amber-light);
  }

  /* ── Platforms ────────────────────────────────────────────── */
  .music__platforms {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    width: 100%;
  }
  .music__platforms-label {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-cream-muted);
    white-space: nowrap;
  }
  .music__platform-list {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-cream-dim);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease;
  }
  .platform-btn__icon {
    width: 16px;
    height: 16px;
    border-radius: 999px;
    display: block;
    background: var(--color-amber-light);
    -webkit-mask: var(--platform-icon-url) center / contain no-repeat;
    mask: var(--platform-icon-url) center / contain no-repeat;
    flex-shrink: 0;
    transition: opacity 0.25s ease;
  }
  .platform-btn:hover {
    border-color: var(--color-amber);
    color: var(--color-cream);
    background: var(--color-surface-2);
  }
  .platform-btn:hover .platform-btn__icon {
    opacity: 1;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 900px) {
    .music__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .music__grid {
      grid-template-columns: 1fr;
    }
    .music__platforms {
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }
  }
</style>
