---
---
<section class="hero" id="hero" aria-label="Eternal Heart — Hero">
  <!-- ── Atmospheric background ─────────────────────────────── -->
  <div class="hero__bg">
    <div class="orb orb--amber"></div>
    <div class="orb orb--sage"></div>
    <div class="orb orb--warm"></div>

    <!-- <div class="hero__mark-wrap" aria-hidden="true">
      <img src="/logomark.svg" alt="" class="hero__mark" width="820" height="637" />
    </div> -->

    <video class="hero__video" autoplay muted loop playsinline>
      <source src="/video/hero.webm" type="video/webm" />
    </video>

    <div class="hero__overlay"></div>
    <div class="hero__grain"></div>
    <div class="hero__vignette"></div>
  </div>

  <!-- ── Content ────────────────────────────────────────────── -->
  <div class="hero__content">
    <p class="hero__eyebrow reveal">YOGA • MEDITATION • MUSIC THERAPY • RELAXATION • WELLNESS</p>

    <h1 class="hero__headline reveal reveal-delay-1">
      Music for the<br />
      <em>heart, nervous system,</em><br />
      and soul.
    </h1>

    <p class="hero__sub reveal reveal-delay-2">
      Welcome to the home of Eternal Heart: music, bansuri flute, sound journeys,<br class="hero__br" />
      and healing experiences born from the spirit of Kauaʻi.
    </p>

    <div class="hero__ctas reveal reveal-delay-3">
      <a href="#music" class="btn btn--primary">Listen</a>
      <a href="#sound-therapy" class="btn btn--ghost">Book a Sound Journey</a>
    </div>
  </div>

</section>

<style>
  /* ── Layout ──────────────────────────────────────────────── */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 680px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Background ──────────────────────────────────────────── */
  .hero__bg {
    position: absolute;
    inset: 0;
    background: #0a0807;
  }

  /* Ambient light orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
    will-change: transform;
  }
  .orb--amber {
    width: clamp(400px, 55vw, 750px);
    height: clamp(400px, 55vw, 750px);
    background: radial-gradient(circle, rgba(185, 115, 42, 0.32) 0%, transparent 68%);
    top: -18%;
    right: -10%;
    animation: drift-a 20s ease-in-out infinite;
  }
  .orb--sage {
    width: clamp(280px, 38vw, 520px);
    height: clamp(280px, 38vw, 520px);
    background: radial-gradient(circle, rgba(46, 76, 46, 0.28) 0%, transparent 68%);
    bottom: -12%;
    left: -8%;
    animation: drift-b 25s ease-in-out infinite;
  }
  .orb--warm {
    width: clamp(200px, 28vw, 380px);
    height: clamp(200px, 28vw, 380px);
    background: radial-gradient(circle, rgba(150, 82, 22, 0.18) 0%, transparent 68%);
    top: 38%;
    left: 22%;
    animation: drift-c 30s ease-in-out infinite;
  }

  @keyframes drift-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(-35px, 28px) scale(1.06); }
    66%       { transform: translate(18px, -38px) scale(0.94); }
  }
  @keyframes drift-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40%       { transform: translate(44px, -26px) scale(1.09); }
    70%       { transform: translate(-28px, 44px) scale(0.91); }
  }
  @keyframes drift-c {
    0%, 100% { transform: translate(0, 0); opacity: 0.7; }
    50%       { transform: translate(-55px, 35px); opacity: 1; }
  }

  .hero__video {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover;
    opacity: 0.38;
    clip-path: inset(var(--hero-video-clip-top, 0px) 0 var(--hero-video-clip-bottom, 0px) 0);
  }

  .hero__mark-wrap {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .hero__mark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(74vw, 920px);
    height: auto;
    opacity: 0.1;
    filter: saturate(0.95) drop-shadow(0 0 36px rgba(200, 136, 58, 0.14));
    transform: translate(-50%, -50%) scale(1.02);
    animation: mark-float 12s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes mark-float {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1.02) rotate(0deg);
      opacity: 0.2;
    }
    50% {
      transform: translate(-50%, calc(-50% - 12px)) scale(1.08) rotate(1.2deg);
      opacity: 0.3;
    }
  }

  /* Multi-layer dark overlay for cinematic feel */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      160deg,
      rgba(9, 8, 10, 0.25)  0%,
      rgba(9, 8, 10, 0.08)  40%,
      rgba(9, 8, 10, 0.55)  80%,
      rgba(9, 8, 10, 0.92) 100%
    );
  }
  .hero__vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      ellipse 80% 70% at 50% 50%,
      transparent 35%,
      rgba(9, 8, 10, 0.55) 100%
    );
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.038;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px;
    pointer-events: none;
  }

  /* ── Hero content ─────────────────────────────────────────── */
  .hero__content {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 0 28px;
    max-width: 860px;
  }

  .hero__eyebrow {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: 30px;
  }

  .hero__headline {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7.5vw, 6.25rem);
    font-weight: 300;
    line-height: 1.08;
    color: var(--color-cream);
    letter-spacing: -0.025em;
    margin-bottom: 32px;
  }
  .hero__headline em {
    font-style: italic;
    color: var(--color-amber-light);
  }

  .hero__sub {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 300;
    color: rgba(232, 220, 200, 0.62);
    line-height: 1.85;
    margin-bottom: 56px;
  }

  .hero__ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero__scroll {
    position: absolute;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @keyframes scroll-pulse {
    0%   { opacity: 0; transform: scaleY(0); transform-origin: top; }
    45%  { opacity: 1; transform: scaleY(1); transform-origin: top; }
    100% { opacity: 0; transform: scaleY(1); transform-origin: bottom; }
  }

  /* ── Mobile ───────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .hero__br { display: none; }
    .hero__ctas { flex-direction: column; align-items: center; }
    .hero__mark {
      width: min(110vw, 640px);
      opacity: 0.2;
    }
  }
</style>

<script>
  // Re-query #hero each call so stale references after ClientRouter swaps don't break clipping
  function updateHeroVideoClip() {
    const heroSection = document.getElementById('hero');
    if (!heroSection) return;
    const rect = heroSection.getBoundingClientRect();
    const clipTop = Math.max(0, rect.top);
    const clipBottom = Math.max(0, window.innerHeight - rect.bottom);
    heroSection.style.setProperty('--hero-video-clip-top', `${clipTop}px`);
    heroSection.style.setProperty('--hero-video-clip-bottom', `${clipBottom}px`);
  }

  let clipFrame = 0;
  function queueHeroVideoClipUpdate() {
    if (clipFrame) return;
    clipFrame = window.requestAnimationFrame(() => {
      clipFrame = 0;
      updateHeroVideoClip();
    });
  }

  // Re-run on every navigation so the fresh #hero element gets its clip-path initialised
  document.addEventListener('astro:page-load', queueHeroVideoClipUpdate);
  window.addEventListener('scroll', queueHeroVideoClipUpdate, { passive: true });
  window.addEventListener('resize', queueHeroVideoClipUpdate);
</script>
