---
---

<section class="signup" id="email-signup">
  <div class="signup__bg" aria-hidden="true">
    <div class="signup__orb signup__orb--1"></div>
    <div class="signup__orb signup__orb--2"></div>
  </div>

  <div class="container">
    <div class="signup__inner reveal">
      <div class="signup__copy">
        <span class="eyebrow">Free Gift</span>
        <h2 class="signup__headline">
          Receive a free<br /><em>sound journey.</em>
        </h2>
        <p class="signup__body">
          Enter your email and I'll send you a free guided meditation and
          ambient sound journey — recorded live on the shores of Kauaʻi.
          A gift for your nervous system.
        </p>
        <ul class="signup__perks">
          <li>
            <span class="signup__perk-dot" aria-hidden="true"></span>
            Free sound journey MP3
          </li>
          <li>
            <span class="signup__perk-dot" aria-hidden="true"></span>
            Early access to new releases &amp; offerings
          </li>
          <li>
            <span class="signup__perk-dot" aria-hidden="true"></span>
            Notes from the practice &amp; creative process
          </li>
        </ul>
      </div>

      <div class="signup__form">
        <iframe
          data-src="https://links.seegodesign.com/widget/form/afdvGMV2bMug7FompVqL"
          style="width:100%;height:440px;border:none;"
          id="inline-afdvGMV2bMug7FompVqL"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="Website Mailing List Signup"
          data-height="440"
          data-layout-iframe-id="inline-afdvGMV2bMug7FompVqL"
          data-form-id="afdvGMV2bMug7FompVqL"
          title="Website Mailing List Signup"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section ─────────────────────────────────────────────── */
  .signup {
    position: relative;
    overflow: hidden;
    padding: 120px 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .signup__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .signup__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }
  .signup__orb--1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(155, 85, 28, 0.2) 0%, transparent 68%);
    top: -150px;
    right: -100px;
    animation: s-drift-1 18s ease-in-out infinite;
  }
  .signup__orb--2 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(38, 62, 36, 0.18) 0%, transparent 68%);
    bottom: -100px;
    left: -80px;
    animation: s-drift-2 22s ease-in-out infinite;
  }
  @keyframes s-drift-1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-30px, 20px); }
  }
  @keyframes s-drift-2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(25px, -18px); }
  }

  /* ── Inner layout ────────────────────────────────────────── */
  .signup__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    position: relative;
    z-index: 2;
  }

  /* ── Copy ─────────────────────────────────────────────────── */
  .signup__headline {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--color-cream);
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }
  .signup__headline em {
    font-style: italic;
    color: var(--color-amber-light);
  }
  .signup__body {
    font-size: 1.0rem;
    line-height: 1.85;
    color: var(--color-cream-dim);
    margin-bottom: 32px;
    max-width: 50ch;
  }
  .signup__perks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .signup__perks li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9rem;
    color: var(--color-cream-dim);
  }
  .signup__perk-dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-amber);
  }

  /* ── Form ─────────────────────────────────────────────────── */
  .signup__form {
    background: rgba(9, 8, 10, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    overflow: hidden;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 840px) {
    .signup__inner { grid-template-columns: 1fr; gap: 48px; }
    .signup__form { padding: 32px 24px; }
  }
</style>

<script>
  // Load the GHL iframe and its embed script only when the signup section
  // is about to enter the viewport — saves loading ~300px of scroll distance worth
  // of external scripts on initial page load.
  document.addEventListener('astro:page-load', () => {
    const section = document.getElementById('email-signup');
    const iframe = section?.querySelector('iframe[data-src]');
    if (!section || !iframe) return;

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();

        // Activate the iframe
        iframe.src = iframe.dataset.src;

        // Load form_embed.js once (it may already be present from a prior navigation)
        if (!document.querySelector('script[src*="form_embed"]')) {
          const s = document.createElement('script');
          s.src = 'https://links.seegodesign.com/js/form_embed.js';
          document.body.appendChild(s);
        }
      },
      // Pre-load 400px before the section reaches the viewport bottom
      { rootMargin: '0px 0px 400px 0px' }
    );

    io.observe(section);
  });
</script>
