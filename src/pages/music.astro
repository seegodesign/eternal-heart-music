---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Music & Discography | Eternal Heart';
const description =
  'Explore albums, singles, and playlists from Eternal Heart, with links to Spotify and other platforms.';

import { getCollection } from 'astro:content';

const releases = await getCollection('releases');
---

<Layout title={title} description={description}>
  <Nav />
  <main class="page-main">
    <section class="section section--sm page-hero">
      <div class="container">
        <span class="eyebrow">Discography</span>
        <h1 class="section-title">Albums & singles for <em>deep listening</em>.</h1>
        <div class="divider"></div>
        <p class="section-body">
          Browse releases, explore sonic moods, and listen on your preferred platform.
        </p>
      </div>
    </section>

    <section class="section page-section">
      <div class="container music-grid">
        {
          releases.map((r) => (
            <article class="card music-card">
              <a href={r.data.spotify} target="_blank" rel="noopener noreferrer">
                <img src={r.data.artwork} alt={`${r.data.title} cover`} loading="lazy" decoding="async" />
              </a>
              <div class="music-card__body">
                <p class="music-card__meta">{r.data.type} • {r.data.year}</p>
                <h2>{r.data.title}</h2>
                <a class="music-card__link" href={r.data.spotify} target="_blank" rel="noopener noreferrer">
                  Spotify
                </a>
                <span class="music-card__link-sep" aria-hidden="true">·</span>
                <a class="music-card__link" href={r.data.bandcamp} target="_blank" rel="noopener noreferrer">
                  Bandcamp
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-main { padding-top: 90px; }
  .page-hero { padding-bottom: 44px; }
  .page-section { padding-top: 40px; }
  .music-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .music-card { overflow: hidden; }
  .music-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .music-card__body { padding: 18px 20px 22px; }
  .music-card__meta {
    color: var(--color-cream-muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .music-card h2 {
    margin: 8px 0 12px;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .music-card__link {
    color: var(--color-amber-light);
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 1020px) {
    .music-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .music-grid { grid-template-columns: 1fr; }
  }
</style>
