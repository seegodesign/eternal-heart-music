---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";

const bowls = [
  {
    note: "C",
    freq: 256,
    color: "#b85530",
    size: 158,
    rate: 1,
  },
  {
    note: "D",
    freq: 288,
    color: "#c87230",
    size: 146,
    rate: 1.1225,
  },
  {
    note: "E",
    freq: 324,
    color: "#c8a030",
    size: 134,
    rate: 1.2599,
  },
  {
    note: "F",
    freq: 341.3,
    color: "#5a8852",
    size: 122,
    rate: 1.3348,
  },
  {
    note: "G",
    freq: 384,
    color: "#4878a0",
    size: 111,
    rate: 1.4983,
  },
  {
    note: "A",
    freq: 432,
    color: "#6858a8",
    size: 101,
    rate: 1.6818,
  },
  {
    note: "B",
    freq: 486,
    color: "#a090c8",
    size: 92,
    rate: 1.8877,
  },
];

const bansuriLoops = [
  { name: "Yaman",       src: "/audio/soundbath/bansuri-yaman.mp3" },
  { name: "Desh",        src: "/audio/soundbath/bansuri-desh.mp3" },
  { name: "Bhimpalasi",  src: "/audio/soundbath/bansuri-bhimpalasi.mp3" },
  { name: "Bhairav",     src: "/audio/soundbath/bansuri-bhairav.mp3" },
  { name: "Hamsadhwani", src: "/audio/soundbath/bansuri-hamsadhwani.mp3" },
  { name: "Bhoopali",   src: "/audio/soundbath/bansuri-bhoopali.mp3" },
];

const chimesLoops = [
  {
    name: "Chimes One",
    src: "/audio/soundbath/chimes-1.mp3",
    mixId: "chimes-1",
  },
  {
    name: "Chimes Two",
    src: "/audio/soundbath/chimes-2.mp3",
    mixId: "chimes-2",
  },
  {
    name: "Chimes Three",
    src: "/audio/soundbath/chimes-3.mp3",
    mixId: "chimes-3",
  },
];

const natureLoops = [
  {
    name: "Nature One",
    src: "/audio/soundbath/nature-1.mp3",
    mixId: "nature-1",
  },
  {
    name: "Nature Two",
    src: "/audio/soundbath/nature-2.mp3",
    mixId: "nature-2",
  },
  {
    name: "Nature Three",
    src: "/audio/soundbath/nature-3.mp3",
    mixId: "nature-3",
  },
];

const synthLoops = [
  { name: "Synth One", src: "/audio/soundbath/synth-1.mp3" },
  { name: "Synth Two", src: "/audio/soundbath/synth-2.mp3" },
  { name: "Synth Three", src: "/audio/soundbath/synth-3.mp3" },
];

// Black-key bowls — ml = margin-left (px) in the flex black-keys row at 0.75× scale
// bs = midpoint between adjacent white-key sizes; ml keeps each sharp centred over its gap
const sharps = [
  { note: "C#", freq: 272, color: "#7c4220", bs: 152, ml: 67, rate: 1.0595 },
  { note: "D#", freq: 306, color: "#7a6020", bs: 140, ml: 10, rate: 1.1892 },
  { note: "F#", freq: 362, color: "#305e78", bs: 116, ml: 116, rate: 1.4142 },
  { note: "G#", freq: 407, color: "#3a5888", bs: 106, ml: 10, rate: 1.5874 },
  { note: "A#", freq: 459, color: "#5048a0", bs: 97, ml: 10, rate: 1.7818 },
];

// Drone notes — one audio file, pitched via playbackRate (rate = 2^(semitones/12) from C)
const drones = [
  { note: "C", rate: 1 },
  { note: "D", rate: 1.1225 },
  { note: "E", rate: 1.2599 },
  { note: "F", rate: 1.3348 },
  { note: "G", rate: 1.4983 },
  { note: "A", rate: 1.6818 },
  { note: "B", rate: 1.8877 },
];
---

<Layout
  title="Interactive Sound Bath | Eternal Heart"
  description="Seven crystal singing bowls tuned to 432 Hz. Tap any bowl to hear it resonate. Let the tones layer and breathe."
>
  <Nav />
  <div class="sb-splash" id="sb-splash" aria-live="polite">
    <img
      src="/logomark.svg"
      class="sb-splash__logo"
      alt=""
      aria-hidden="true"
    />
    <h2 class="sb-splash-heading">Welcome, beloved.</h2>
    <p class="sb-splash-intro">
      First, let's start with a drone to establish the tonal anchor
    </p>
    <span class="sb-splash__hint">tap anywhere to begin</span>
  </div>
  <main class="sb-console">
    <!-- Console body: stage (left) + mixer (right) -->
    <div class="sb-console-body" data-mixer-open="true">
      <!-- Stage: tabbed instrument panels -->
      <div class="sb-console-stage">
        <!-- Tab bar -->
        <nav class="sb-tabs" role="tablist" aria-label="Instruments">
          <button
            class="sb-tab sb-tab--active"
            role="tab"
            aria-selected="true"
            aria-controls="sb-panel-drone"
            id="sb-tab-drone"
            data-sb-panel="drone"
          >
            Drone
          </button>
          <button
            class="sb-tab"
            role="tab"
            aria-selected="false"
            aria-controls="sb-panel-bowls"
            id="sb-tab-bowls"
            data-sb-panel="bowls"
          >
            Bowls
          </button>
          <button
            class="sb-tab"
            role="tab"
            aria-selected="false"
            aria-controls="sb-panel-wind"
            id="sb-tab-wind"
            data-sb-panel="wind"
          >
            Flute
          </button>
          <button
            class="sb-tab"
            role="tab"
            aria-selected="false"
            aria-controls="sb-panel-ambience"
            id="sb-tab-ambience"
            data-sb-panel="ambience"
          >
            Ambience
          </button>
          <button
            class="sb-tab-silence"
            id="sb-tab-silence"
            type="button"
            aria-label="Stop all sounds"
          >
            <img
              src="/icons/stop.svg"
              class="sb-tab-silence__icon"
              alt=""
              aria-hidden="true"
            />
            <span class="sb-tab-silence__text">Stop</span>
            <span class="sb-tab-silence__countdown" aria-live="assertive" hidden></span>
          </button>
          <button
            class="sb-rec-btn"
            id="sb-rec-btn"
            type="button"
            aria-label="Start recording"
            aria-pressed="false"
          >
            <span class="sb-rec-btn__dot" aria-hidden="true"></span>
            <span class="sb-rec-btn__text" id="sb-rec-text">Rec</span>
          </button>
          <button
            class="mix-toggle-btn"
            id="mix-toggle-btn"
            type="button"
            aria-label="Toggle mixer"
            aria-expanded="true"
          >
            <img
              src="/icons/mixer.svg"
              class="mix-toggle-btn__icon"
              alt=""
              aria-hidden="true"
            />
            Mixer
          </button>
        </nav>

        <!-- Drone panel (visible by default) -->
        <div
          class="sb-panel"
          id="sb-panel-drone"
          role="tabpanel"
          aria-labelledby="sb-tab-drone"
        >
          <h2 class="sb-panel-title">Drone</h2>
          <div class="sb-drone-panel">
            <div class="sb-drone-instrument">
              <span class="sb-drone-label">Synth</span>
              <div class="sb-drone-grid">
                {
                  drones.map((d) => (
                    <button
                      class="sb-drone-note"
                      type="button"
                      data-src="/audio/soundbath/drone-c.mp3"
                      data-rate={d.rate}
                      data-note={d.note}
                      aria-pressed="false"
                      aria-label={`Toggle ${d.note} synth drone`}
                    >
                      <span class="sb-drone-note__label">{d.note}</span>
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="sb-drone-instrument">
              <div class="tanpura-toggle-row">
                <span class="sb-drone-label">Tanpura</span>
                <div class="tanpura-toggle" id="tanpura-toggle" role="switch" aria-checked="false" tabindex="0" aria-label="Toggle tanpura tuning: MA or PA">
                  <span class="tanpura-toggle__label tanpura-toggle__label--ma">MA</span>
                  <span class="tanpura-toggle__track">
                    <span class="tanpura-toggle__thumb"></span>
                  </span>
                  <span class="tanpura-toggle__label tanpura-toggle__label--pa">PA</span>
                </div>
              </div>
              <!-- Pa row (default visible) -->
              <div class="sb-drone-grid" id="tanpura-pa-row">
                {
                  drones.map((d) => (
                    <button
                      class="sb-drone-note sb-drone-note--tanpura"
                      type="button"
                      data-src="/audio/soundbath/tanpura-c.mp3"
                      data-rate={d.rate}
                      data-note={d.note}
                      aria-pressed="false"
                      aria-label={`Toggle ${d.note} tanpura (Sa–Pa)`}
                    >
                      <span class="sb-drone-note__label">{d.note}</span>
                    </button>
                  ))
                }
              </div>
              <!-- Ma row (hidden until toggled) -->
              <div class="sb-drone-grid" id="tanpura-ma-row" hidden>
                {
                  drones.map((d) => (
                    <button
                      class="sb-drone-note sb-drone-note--tanpura-ma"
                      type="button"
                      data-src="/audio/soundbath/tanpura-ma-c.mp3"
                      data-rate={d.rate}
                      data-note={d.note}
                      aria-pressed="false"
                      aria-label={`Toggle ${d.note} tanpura (Sa–Ma)`}
                    >
                      <span class="sb-drone-note__label">{d.note}</span>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- Bowls panel -->
        <div
          class="sb-panel"
          id="sb-panel-bowls"
          role="tabpanel"
          aria-labelledby="sb-tab-bowls"
          hidden
        >
          <h2 class="sb-panel-title">Bowls</h2>
          <div class="sb-piano">
            <!-- Black keys (sharps/flats) -->
            <div
              class="sb-piano__blacks"
              role="group"
              aria-label="Sharp and flat bowls"
            >
              {
                sharps.map((s) => (
                  <button
                    class="sb-bowl sb-bowl--sharp"
                    type="button"
                    style={`--bs: ${s.bs}; margin-left: ${s.ml}px;`}
                    data-freq={s.freq}
                    data-src="/audio/soundbath/bowl-c.mp3"
                    data-rate={s.rate}
                    aria-label={`${s.note} bowl, ${s.freq} Hz`}
                  >
                    <span class="sb-bowl__inner" aria-hidden="true" />
                    <span class="sb-bowl__labels">
                      <span class="sb-bowl__note">{s.note}</span>
                    </span>
                  </button>
                ))
              }
            </div>
            <!-- White keys (naturals) -->
            <div
              class="sb-piano__whites"
              role="group"
              aria-label="Tap a bowl to play"
            >
              {
                bowls.map((b) => (
                  <button
                    class="sb-bowl"
                    type="button"
                    style={`--bs: ${b.size};`}
                    data-freq={b.freq}
                    data-src="/audio/soundbath/bowl-c.mp3"
                    data-rate={b.rate}
                    aria-label={`${b.note} bowl, ${b.freq} Hz`}
                  >
                    <span class="sb-bowl__inner" aria-hidden="true" />
                    <span class="sb-bowl__labels">
                      <span class="sb-bowl__note">{b.note}</span>
                    </span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Wind (Bansuri) panel -->
        <div
          class="sb-panel"
          id="sb-panel-wind"
          role="tabpanel"
          aria-labelledby="sb-tab-wind"
          hidden
        >
          <h2 class="sb-panel-title">Flute</h2>
          <div class="sb-flute-panel">
            <div class="sb-flute-key-row">
              <span class="sb-flute-key-label">Key</span>
              <div class="sb-flute-keys">
                {
                  drones.map((d) => (
                    <button
                      class:list={["sb-flute-key", { active: d.note === "C" }]}
                      type="button"
                      data-rate={d.rate}
                      data-note={d.note}
                      aria-pressed={d.note === "C" ? "true" : "false"}
                      aria-label={`Flute key ${d.note}`}
                    >
                      {d.note}
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="bl-grid">
                  {
                    bansuriLoops.map((loop) => (
                      <button
                        class="bl-btn"
                        type="button"
                        data-src={loop.src}
                        data-mix-id="flute"
                        aria-pressed="false"
                        aria-label={`Toggle ${loop.name} bansuri loop`}
                      >
                        <span class="bl-wave" aria-hidden="true">
                          <>
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                          </>
                        </span>
                        <span class="bl-btn__name">{loop.name}</span>
                      </button>
                    ))
                  }
                </div>
          </div>
        </div>

        <!-- Ambience (Chimes + Nature) panel -->
        <div
          class="sb-panel"
          id="sb-panel-ambience"
          role="tabpanel"
          aria-labelledby="sb-tab-ambience"
          hidden
        >
          <h2 class="sb-panel-title">Ambience</h2>
          <div class="bl-ambience-columns">
            <div class="bl-ambience-col">
              <span class="bl-ambience-col-header">Chimes</span>
              <div class="bl-grid">
                {
                  chimesLoops.map((loop) => (
                    <button
                      class="bl-btn"
                      type="button"
                      data-src={loop.src}
                      data-mix-id="chimes"
                      aria-pressed="false"
                      aria-label={`Toggle ${loop.name}`}
                    >
                      <span class="bl-wave" aria-hidden="true">
                        <>
                          <span />
                          <span />
                          <span />
                          <span />
                          <span />
                        </>
                      </span>
                      <span class="bl-btn__name">{loop.name}</span>
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="bl-ambience-col">
              <span class="bl-ambience-col-header">Nature</span>
              <div class="bl-grid">
                {
                  natureLoops.map((loop) => (
                    <button
                      class="bl-btn"
                      type="button"
                      data-src={loop.src}
                      data-mix-id="nature"
                      aria-pressed="false"
                      aria-label={`Toggle ${loop.name}`}
                    >
                      <span class="bl-wave" aria-hidden="true">
                        <>
                          <span />
                          <span />
                          <span />
                          <span />
                          <span />
                        </>
                      </span>
                      <span class="bl-btn__name">{loop.name}</span>
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="bl-ambience-col">
              <span class="bl-ambience-col-header">Synth</span>
              <div class="bl-grid">
                {
                  synthLoops.map((loop) => (
                    <button
                      class="bl-btn"
                      type="button"
                      data-src={loop.src}
                      data-mix-id="synth"
                      aria-pressed="false"
                      aria-label={`Toggle ${loop.name}`}
                    >
                      <span class="bl-wave" aria-hidden="true">
                        <>
                          <span />
                          <span />
                          <span />
                          <span />
                          <span />
                        </>
                      </span>
                      <span class="bl-btn__name">{loop.name}</span>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div><!-- /.sb-console-stage -->

      <!-- Mixer aside: always visible -->
      <aside class="sb-console-mixer" aria-label="Mixer">
        <img
          src="/logomark.svg"
          class="mix-logomark"
          alt=""
          aria-hidden="true"
        />
        <h2 class="mix-heading">Mixer</h2>
        <div class="mix-board">
          <div class="mix-channel">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-drone"
                min="0"
                max="100"
                value="80"
                data-mix-id="drone"
                aria-label="Drone volume"
              />
            </div>
            <span class="mix-label">Synth</span>
            <span class="mix-value" id="mix-drone-val">80</span>
          </div>
          <div class="mix-channel">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-tanpura"
                min="0"
                max="100"
                value="80"
                data-mix-id="tanpura"
                aria-label="Tanpura volume"
              />
            </div>
            <span class="mix-label">Tanpura</span>
            <span class="mix-value" id="mix-tanpura-val">80</span>
          </div>
          <div class="mix-channel">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-bowls"
                min="0"
                max="100"
                value="80"
                data-mix-id="bowls"
                aria-label="Bowl master volume"
              />
            </div>
            <span class="mix-label">Bowls</span>
            <span class="mix-value" id="mix-bowls-val">80</span>
          </div>
          <div class="mix-channel">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-flute"
                min="0"
                max="100"
                value="80"
                data-mix-id="flute"
                aria-label="Flute volume"
              />
            </div>
            <span class="mix-label">Flute</span>
            <span class="mix-value" id="mix-flute-val">80</span>
          </div>
          <div class="mix-channel">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-chimes"
                min="0"
                max="100"
                value="80"
                data-mix-id="chimes"
                aria-label="Chimes volume"
              />
            </div>
            <span class="mix-label">Chimes</span>
            <span class="mix-value" id="mix-chimes-val">80</span>
          </div>
          <div class="mix-channel">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-nature"
                min="0"
                max="100"
                value="80"
                data-mix-id="nature"
                aria-label="Nature volume"
              />
            </div>
            <span class="mix-label">Nature</span>
            <span class="mix-value" id="mix-nature-val">80</span>
          </div>
          <div class="mix-channel">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-synth"
                min="0"
                max="100"
                value="80"
                data-mix-id="synth"
                aria-label="Synth volume"
              />
            </div>
            <span class="mix-label">Synth</span>
            <span class="mix-value" id="mix-synth-val">80</span>
          </div>
          <div class="mix-channel mix-channel--master">
            <div class="mix-fader-wrap">
              <input
                class="mix-fader"
                type="range"
                id="mix-master"
                min="0"
                max="300"
                value="150"
                data-mix-id="master"
                aria-label="Master volume"
              />
            </div>
            <span class="mix-label">Master</span>
            <span class="mix-value" id="mix-master-val">150</span>
          </div>
        </div>
      </aside>
    </div><!-- /.sb-console-body -->
    <div class="mix-backdrop" id="mix-backdrop" aria-hidden="true"></div>

    <!-- Scope strip (full width, always visible) -->
    <div class="sb-scope-strip">
      <canvas id="scope-canvas" class="scope-canvas" aria-hidden="true"
      ></canvas>
    </div>
  </main>
</Layout>

<style>
  /* Prevent page-level scroll — this page is a fixed-height app shell */
  :global(html),
  :global(body) {
    overflow: hidden;
  }

  /* Hide the persistent music player on this page */
  :global(.hero__player-layer) {
    display: none !important;
  }

  /* ── Console layout ──────────────────────────────────────── */
  .sb-console {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - var(--nav-h, 84px));
    margin-top: var(--nav-h, 84px);
    background: var(--color-bg);
    overflow: hidden;
  }

  /* Scope strip */
  .sb-scope-strip {
    flex: 0 0 90px;
    height: 90px; /* explicit height so canvas % works */
    position: relative;
    background: rgb(5, 3, 1);
    border-top: 1px solid var(--color-border);
  }
  .scope-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Console body: stage + mixer side by side */
  .sb-console-body {
    flex: 1 1 0;
    display: flex;
    min-height: 0;
  }

  /* Stage: holds tabs + instrument panels */
  .sb-console-stage {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-right: 1px solid var(--color-border);
  }

  /* ── Tab bar ─────────────────────────────────────────────── */
  .sb-tabs {
    display: flex;
    flex: 0 0 auto;
    padding: 0 28px;
    border-bottom: 1px solid var(--color-border);
    background: rgba(8, 5, 2, 0.7);
  }
  .sb-tab {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.5);
    padding: 13px 20px 11px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
    margin-bottom: -1px;
  }
  .sb-tab:hover {
    color: rgba(200, 136, 58, 0.72);
  }
  .sb-tab--active {
    color: var(--color-amber);
    border-bottom-color: var(--color-amber);
  }
  .mix-toggle-btn {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.5);
    padding: 13px 16px 11px;
    margin-left: 0;
    background: none;
    border: none;
    border-left: 1px solid var(--color-border);
    cursor: pointer;
    transition: color 0.2s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .mix-toggle-btn__icon {
    width: 14px;
    height: 12px;
    flex-shrink: 0;
    opacity: 0.5;
    filter: invert(62%) sepia(42%) saturate(600%) hue-rotate(5deg)
      brightness(95%);
    transition:
      opacity 0.2s,
      filter 0.2s;
  }
  .mix-toggle-btn:hover .mix-toggle-btn__icon {
    opacity: 1;
    filter: invert(62%) sepia(42%) saturate(600%) hue-rotate(5deg)
      brightness(110%);
  }
  .mix-toggle-btn[aria-expanded="true"] .mix-toggle-btn__icon {
    opacity: 1;
    filter: invert(72%) sepia(55%) saturate(500%) hue-rotate(5deg)
      brightness(105%);
  }
  .mix-toggle-btn:hover {
    color: rgba(200, 136, 58, 0.85);
  }
  .mix-toggle-btn[aria-expanded="true"] {
    color: var(--color-amber);
  }
  .sb-tab-silence {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.5);
    padding: 13px 16px 11px 0;
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .sb-tab-silence__icon {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    /* SVG uses currentColor but <img> can't inherit — filter maps white→amber at 50% opacity */
    opacity: 0.5;
    filter: invert(62%) sepia(42%) saturate(600%) hue-rotate(5deg)
      brightness(95%);
    transition:
      opacity 0.2s,
      filter 0.2s;
  }
  .sb-tab-silence:hover {
    color: rgba(220, 80, 60, 0.85);
  }
  .sb-tab-silence:hover .sb-tab-silence__icon {
    opacity: 1;
    filter: invert(30%) sepia(90%) saturate(400%) hue-rotate(350deg)
      brightness(110%);
  }
  .sb-tab-silence__countdown {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(220, 80, 60, 0.8);
    min-width: 1ch;
    text-align: center;
  }

  /* ── Record button ───────────────────────────────────────── */
  .sb-rec-btn {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.5);
    padding: 13px 16px 11px;
    background: none;
    border: none;
    border-left: 1px solid var(--color-border);
    cursor: pointer;
    transition: color 0.2s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .sb-rec-btn:hover {
    color: rgba(200, 136, 58, 0.85);
  }
  .sb-rec-btn__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .sb-rec-btn--active {
    color: #e05050 !important;
  }
  .sb-rec-btn--active .sb-rec-btn__dot {
    background: #e05050;
    animation: rec-pulse 1.2s ease-in-out infinite;
  }
  .sb-rec-btn--active:hover {
    color: #e87070 !important;
  }
  @keyframes rec-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.15; }
  }

  /* ── Panels ──────────────────────────────────────────────── */
  .sb-panel {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 28px;
    min-height: 0;
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }
  .sb-panel[hidden] {
    display: none !important;
  }
  @keyframes sb-panel-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .sb-panel:not([hidden]) {
    animation: sb-panel-fade-in 1s ease;
  }

  .sb-panel-title {
    font-family: var(--font-serif);
    font-size: 44px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(200, 136, 58, 0.65);
    text-align: center;
    flex-shrink: 0;
  }

  /* ── Panel background images ─────────────────────────────── */
  .sb-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    pointer-events: none;
    z-index: -1;
  }
  #sb-panel-drone::before {
    background-image: url('/images/tanpura.webp');
  }
  #sb-panel-bowls::before {
    background-image: url("/images/bowls.avif");
  }
  #sb-panel-wind::before {
    background-image: url("/images/journal/ancient-art-of-bansuri-flute.avif");
  }
  #sb-panel-ambience::before {
    background-image: url("/images/forest.avif");
  }

  /* ── Singing bowls — piano keyboard layout ─────────────── */
  .sb-piano {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .sb-piano__blacks {
    display: flex;
    align-items: flex-end;
    margin-bottom: -18px; /* overlap white key tops slightly */
    position: relative;
    z-index: 1;
  }
  .sb-piano__whites {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }

  /* Sharp/flat bowls: only note name shown */
  .sb-bowl--sharp .sb-bowl__note {
    font-size: calc(var(--bs) * 0.105px);
    color: rgba(255, 255, 255, 0.75);
  }

  .sb-bowl {
    --bc: #c8883a;
    --bs: 100;
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--bs) * 0.75px);
    height: calc(var(--bs) * 0.75px);
    border-radius: 50%;
    border: none;
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    transition: transform 0.1s ease;
    /* dark outer rim — inner element sits inset on top of this */
    background: color-mix(in srgb, var(--bc) 22%, #050302 78%);
  }

  .sb-bowl__inner {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse 60% 50% at 36% 36%,
      color-mix(in srgb, var(--bc) 70%, #000 30%),
      color-mix(in srgb, var(--bc) 52%, #000 48%) 45%,
      color-mix(in srgb, var(--bc) 35%, #000 65%) 75%,
      color-mix(in srgb, var(--bc) 22%, #000 78%) 100%
    );
    box-shadow:
      inset -4px -5px 14px rgba(0, 0, 0, 0.6),
      inset 2px 3px 6px rgba(255, 255, 255, 0.07),
      0 4px 18px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(0, 0, 0, 0.4);
    transition: box-shadow 0.25s ease;
  }

  .sb-bowl:hover {
    transform: scale(1.05);
  }
  .sb-bowl:active {
    transform: scale(0.97);
    transition-duration: 0.05s;
  }

  .sb-bowl:hover .sb-bowl__inner {
    box-shadow:
      inset -3px -4px 10px rgba(0, 0, 0, 0.45),
      inset 2px 3px 8px rgba(255, 255, 255, 0.15),
      0 6px 24px rgba(0, 0, 0, 0.55),
      0 0 24px color-mix(in srgb, var(--bc) 50%, transparent),
      0 0 0 1px rgba(0, 0, 0, 0.3);
  }

  .sb-bowl.playing .sb-bowl__inner {
    box-shadow:
      inset -3px -4px 10px rgba(0, 0, 0, 0.45),
      inset 2px 3px 8px rgba(255, 255, 255, 0.15),
      0 0 36px color-mix(in srgb, var(--bc) 70%, transparent),
      0 0 12px color-mix(in srgb, var(--bc) 45%, transparent),
      0 0 0 1px rgba(0, 0, 0, 0.3);
  }

  .sb-bowl__labels {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    pointer-events: none;
  }
  .sb-bowl__note {
    font-family: var(--font-serif);
    font-size: calc(var(--bs) * 0.12px);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1;
  }
  /* Ripple */
  @keyframes sb-ripple-anim {
    from {
      opacity: 0.5;
      transform: scale(0.85);
    }
    to {
      opacity: 0;
      transform: scale(3);
    }
  }
  .sb-ripple,
  .sb-ripple--2 {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--bc);
    animation: sb-ripple-anim 1.8s cubic-bezier(0.2, 0.5, 0.4, 1) forwards;
    pointer-events: none;
  }
  .sb-ripple--2 {
    animation-delay: 0.35s;
    opacity: 0.4;
  }

  /* ── Drone panel ─────────────────────────────────────────── */
  .sb-drone-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  .sb-drone-instrument {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .sb-drone-label {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.5);
  }

  /* ── Tanpura MA / PA toggle ──────────────────────────────── */
  .tanpura-toggle-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tanpura-toggle {
    display: flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    user-select: none;
  }
  .tanpura-toggle__label {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .tanpura-toggle__label--ma {
    color: rgba(200, 136, 58, 0.35);
  }
  .tanpura-toggle__label--pa {
    color: rgba(200, 136, 58, 0.75);
  }
  /* When MA is selected (aria-checked=true) flip the label opacities */
  .tanpura-toggle[aria-checked="true"] .tanpura-toggle__label--ma {
    color: rgba(200, 136, 58, 0.75);
  }
  .tanpura-toggle[aria-checked="true"] .tanpura-toggle__label--pa {
    color: rgba(200, 136, 58, 0.35);
  }
  .tanpura-toggle__track {
    position: relative;
    width: 34px;
    height: 18px;
    background: rgba(200, 136, 58, 0.15);
    border: 1px solid rgba(200, 136, 58, 0.3);
    border-radius: 9px;
    transition: background 0.2s;
  }
  .tanpura-toggle__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-amber);
    transition: transform 0.2s;
  }
  /* Thumb moves right = PA side (default). Left = MA side. */
  .tanpura-toggle[aria-checked="false"] .tanpura-toggle__thumb {
    transform: translateX(16px); /* PA */
  }
  .tanpura-toggle[aria-checked="true"] .tanpura-toggle__thumb {
    transform: translateX(0px); /* MA */
  }
  .sb-drone-grid {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .sb-drone-note {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: rgba(12, 8, 4, 0.7);
    border: 1px solid var(--color-border-hi);
    cursor: pointer;
    transition:
      background 0.2s,
      box-shadow 0.2s,
      border-color 0.2s;
  }
  .sb-drone-note:hover {
    background: rgba(200, 136, 58, 0.07);
    box-shadow: 0 0 16px rgba(200, 136, 58, 0.14);
  }
  .sb-drone-note.active {
    background: rgba(200, 136, 58, 0.11);
    border-color: var(--color-amber);
    box-shadow: 0 0 28px rgba(200, 136, 58, 0.22);
    animation: drone-pulse 3s ease-in-out infinite;
  }
  .sb-drone-note__label {
    font-family: var(--font-serif);
    font-size: 22px;
    letter-spacing: 0.04em;
    color: rgba(200, 136, 58, 0.6);
    transition: color 0.2s;
  }
  .sb-drone-note.active .sb-drone-note__label {
    color: var(--color-cream);
  }
  @keyframes drone-pulse {
    0%,
    100% {
      box-shadow: 0 0 20px rgba(200, 136, 58, 0.18);
    }
    50% {
      box-shadow: 0 0 40px rgba(200, 136, 58, 0.38);
    }
  }

  /* ── Bansuri (Wind) panel ────────────────────────────────── */
  .bl-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 380px;
  }
  /* ── Ambience two-column layout ──────────────────────────── */
  .bl-ambience-columns {
    display: flex;
    gap: 28px;
    width: 100%;
    max-width: 780px;
  }
  .bl-ambience-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bl-ambience-col .bl-grid {
    max-width: none;
  }
  .bl-ambience-col-header {
    font-family: var(--font-sans);
    font-size: 16px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.8);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Flute key selector ──────────────────────────────────── */
  .sb-flute-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 780px;
  }
  .sb-flute-key-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
  }
  .sb-flute-key-label {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.7);
  }
  .sb-flute-keys {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: nowrap;
  }
  .sb-flute-key {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(12, 8, 4, 0.7);
    border: 1px solid var(--color-border-hi);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 18px;
    color: rgba(200, 136, 58, 0.6);
    transition:
      background 0.2s,
      box-shadow 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .sb-flute-key:hover {
    background: rgba(200, 136, 58, 0.07);
    box-shadow: 0 0 16px rgba(200, 136, 58, 0.14);
  }
  .sb-flute-key.active {
    background: rgba(200, 136, 58, 0.11);
    border-color: var(--color-amber);
    box-shadow: 0 0 28px rgba(200, 136, 58, 0.22);
    color: var(--color-cream);
  }

  .bl-btn {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    background: rgba(10, 7, 3, 0.65);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.25s,
      border-color 0.25s;
  }
  .bl-btn:hover {
    background: rgba(200, 136, 58, 0.06);
    border-color: var(--color-border-hi);
  }
  .bl-btn.active {
    background: rgba(200, 136, 58, 0.1);
    border-color: var(--color-amber);
  }

  .bl-wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 18px;
    flex-shrink: 0;
  }
  .bl-wave span {
    display: block;
    width: 2px;
    height: 7px;
    background: rgba(200, 136, 58, 0.4);
    border-radius: 1px;
  }
  .bl-btn.active .bl-wave span {
    background: var(--color-amber);
    animation: bl-wave-anim 0.55s ease-in-out infinite alternate;
  }
  .bl-btn.active .bl-wave span:nth-child(2) {
    animation-delay: 0.11s;
  }
  .bl-btn.active .bl-wave span:nth-child(3) {
    animation-delay: 0.22s;
  }
  .bl-btn.active .bl-wave span:nth-child(4) {
    animation-delay: 0.08s;
  }
  .bl-btn.active .bl-wave span:nth-child(5) {
    animation-delay: 0.17s;
  }

  @keyframes bl-wave-anim {
    from {
      transform: scaleY(0.3);
    }
    to {
      transform: scaleY(2);
    }
  }

  .bl-btn__name {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 1);
    flex: 1;
  }

  /* ── Mixer aside ─────────────────────────────────────────── */
  @keyframes mix-logo-pulse {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(1.05);
    }
  }
  .mix-logomark {
    width: 148px;
    height: auto;
    opacity: 0.25;
    animation: mix-logo-pulse 4s ease-in-out infinite;
    flex-shrink: 0;
    margin-bottom: 50px;
  }
  .mix-heading {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-amber);
    opacity: 0.6;
    margin: 0 0 8px;
  }
  .sb-console-mixer {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 20px;
    gap: 20px;
    background: rgba(7, 5, 2, 0.75);
    overflow-y: auto;
    overflow-x: hidden;
    max-width: 500px;
    transition:
      max-width 0.35s ease,
      padding-left 0.35s ease,
      padding-right 0.35s ease,
      opacity 0.25s ease;
  }
  /* Desktop: mixer collapses when toggled */
  .sb-console-body[data-mixer-open="false"] .sb-console-mixer {
    max-width: 0;
    padding-left: 0;
    padding-right: 0;
    opacity: 0;
    pointer-events: none;
  }

  .mix-board {
    display: flex;
    align-items: flex-end;
    gap: 4px;
  }

  .mix-channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 48px;
  }

  .mix-channel--master {
    padding-left: 12px;
    margin-left: 8px;
  }

  /* Vertical fader: rotate a horizontal <input type=range> */
  .mix-fader-wrap {
    width: 48px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .mix-fader {
    appearance: none;
    -webkit-appearance: none;
    width: 160px;
    height: 3px;
    transform: rotate(-90deg);
    cursor: pointer;
    background: transparent;
    outline: none;
    border: none;
  }
  .mix-fader::-webkit-slider-runnable-track {
    height: 3px;
    background: rgba(200, 136, 58, 0.18);
    border-radius: 2px;
  }
  .mix-fader::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-amber);
    margin-top: -5.5px;
    box-shadow: 0 0 6px rgba(200, 136, 58, 0.5);
    cursor: pointer;
    transition:
      transform 0.1s,
      box-shadow 0.1s;
  }
  .mix-fader::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    box-shadow: 0 0 10px rgba(200, 136, 58, 0.7);
  }
  .mix-fader::-moz-range-track {
    height: 3px;
    background: rgba(200, 136, 58, 0.18);
    border-radius: 2px;
  }
  .mix-fader::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-amber);
    border: none;
    box-shadow: 0 0 6px rgba(200, 136, 58, 0.5);
    cursor: pointer;
  }
  .mix-channel--master .mix-fader::-webkit-slider-thumb {
    background: var(--color-cream);
    box-shadow: 0 0 6px rgba(232, 220, 200, 0.5);
    transition: background 0.15s, box-shadow 0.15s;
  }
  .mix-channel--master .mix-fader::-moz-range-thumb {
    background: var(--color-cream);
  }
  .mix-channel--master.is-clipping .mix-fader::-webkit-slider-thumb {
    background: #e04444 !important;
    box-shadow: 0 0 10px rgba(224, 68, 68, 0.8) !important;
  }
  .mix-channel--master.is-clipping .mix-fader::-moz-range-thumb {
    background: #e04444 !important;
  }

  /* ── Larger touch targets on touch devices ─────────────── */
  @media (pointer: coarse) {
    .mix-fader-wrap {
      width: 56px;
    }
    .mix-fader::-webkit-slider-thumb {
      width: 28px;
      height: 28px;
      margin-top: -12.5px;
    }
    .mix-fader::-moz-range-thumb {
      width: 28px;
      height: 28px;
    }
  }

  .mix-label {
    font-family: var(--font-sans);
    font-size: 8px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 1);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 46px;
  }
  .mix-channel--master .mix-label {
    color: rgba(232, 220, 200, 0.8);
  }

  .mix-value {
    font-family: var(--font-sans);
    font-size: 8px;
    letter-spacing: 0.05em;
    color: rgba(200, 136, 58, 0.8);
    text-align: center;
    min-width: 20px;
  }

  /* Silence button */
  .sb-silence {
    font-family: var(--font-sans);
    font-size: 8px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(200, 136, 58, 0.4);
    padding: 10px 20px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .sb-silence:hover {
    color: var(--color-amber);
    border-color: var(--color-border-hi);
  }

  /* ── Splash screen ─────────────────────────────────────── */
  .sb-splash {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    flex-direction: column;
    align-items: center;
