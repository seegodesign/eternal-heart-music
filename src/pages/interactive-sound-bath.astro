<script>
  /** ── Singing bowl audio engine ─────────────────────────────
   *  - Real samples from /audio/bowls/*.mp3 when available
   *  - Inharmonic-partial synthesis as instant fallback
   *  - rawCache stores pre-fetched ArrayBuffers (no AudioContext needed)
   *  - bufCache stores decoded AudioBuffers (cleared on context close)
   *  - Idle pre-fetch so first tap is instant
   */

  let audioCtx: AudioContext | null = null;
  const rawCache = new Map<string, ArrayBuffer>(); // fetched bytes
  const bufCache = new Map<string, AudioBuffer>(); // decoded buffers

  // Drone looping state
  type DroneCtrl = {
    note: string;
    rate: number;
    stop: (fadeDur?: number) => void;
  } | null;
  let droneController: DroneCtrl = null;
  let tanpuraController: DroneCtrl = null;
  let tanpuraMaController: DroneCtrl = null;
  let fluteKey = { note: "C", rate: 1 };
  const bansuriControllers = new Map<
    string,
    { stop: (fadeDur?: number) => void }
  >();
  const mixerGains = new Map<string, GainNode>();

  // Scope visualiser state
  let analyserNode: AnalyserNode | null = null;
  let scopeCanvas: HTMLCanvasElement | null = null;
  let scopeCtx2d: CanvasRenderingContext2D | null = null;
  let scopeData: Uint8Array<ArrayBuffer> | null = null;
  let clipHoldTimeout: ReturnType<typeof setTimeout> | null = null;

  // Recorder state
  let scriptProcessor: ScriptProcessorNode | null = null;
  let recFadeGain: GainNode | null = null;
  let recSamples: Float32Array[] = [];
  let recSampleRate = 0;
  let recTimerInterval: ReturnType<typeof setInterval> | null = null;
  let recStartTime = 0;

  function getCtx(): AudioContext {
    if (!audioCtx) {
      audioCtx = new (
        window.AudioContext || (window as any).webkitAudioContext
      )();
    }
    if (audioCtx.state === "suspended") audioCtx.resume();
    return audioCtx;
  }

  // ── Per-channel mixer gain node ────────────────────────────────
  // Lazily created on first use; reads the current slider value so levels
  // are already correct even on the very first note played.
  function getMixerGain(id: string): GainNode {
    if (mixerGains.has(id)) return mixerGains.get(id)!;
    const ctx = getCtx();
    const gain = ctx.createGain();
    const slider = document.getElementById(
      "mix-" + id,
    ) as HTMLInputElement | null;
    gain.gain.value = slider ? parseFloat(slider.value) / 100 : 0.8;
    gain.connect(getMasterGain());
    mixerGains.set(id, gain);
    return gain;
  }

  // Master gain sits between all channel gains and ctx.destination.
  // Stored in mixerGains under 'master' so it auto-clears on silence.
  function getMasterGain(): GainNode {
    if (mixerGains.has("master")) return mixerGains.get("master")!;
    const ctx = getCtx();
    const gain = ctx.createGain();
    const slider = document.getElementById(
      "mix-master",
    ) as HTMLInputElement | null;
    gain.gain.value = slider ? parseFloat(slider.value) / 100 : 1.0;
    const an = getAnalyser(ctx);
    gain.connect(an);
    an.connect(ctx.destination);
    mixerGains.set("master", gain);
    return gain;
  }

  // ── Scope visualiser ──────────────────────────────────────────

  function getAnalyser(ctx?: AudioContext): AnalyserNode {
    if (analyserNode) return analyserNode;
    const c = ctx ?? getCtx();
    analyserNode = c.createAnalyser();
    analyserNode.fftSize = 2048;
    analyserNode.smoothingTimeConstant = 0.75;
    return analyserNode;
  }

  function drawScopeFrame(): void {
    if (!scopeCanvas || !scopeCtx2d) return;
    const c = scopeCtx2d;
    const W = scopeCanvas.offsetWidth;
    const H = scopeCanvas.offsetHeight;

    c.clearRect(0, 0, W, H);

    if (analyserNode && audioCtx && audioCtx.state === "running") {
      const n = analyserNode.fftSize;
      if (!scopeData || scopeData.length !== n)
        scopeData = new Uint8Array(n) as Uint8Array<ArrayBuffer>;
      analyserNode.getByteTimeDomainData(scopeData);

      // Clip detection — byte values 0 or 255 mean ±full-scale
      const masterCh = document.querySelector<HTMLElement>(".mix-channel--master");
      if (masterCh) {
        let clipping = false;
        for (let s = 0; s < scopeData.length; s++) {
          if (scopeData[s] <= 1 || scopeData[s] >= 254) { clipping = true; break; }
        }
        if (clipping) {
          masterCh.classList.add("is-clipping");
          if (clipHoldTimeout !== null) clearTimeout(clipHoldTimeout);
          clipHoldTimeout = setTimeout(() => {
            masterCh.classList.remove("is-clipping");
            clipHoldTimeout = null;
          }, 1500);
        }
      }

      // Draw one segment per CSS pixel for a clean line
      const step = Math.max(1, Math.floor(n / W));
      c.save();
      c.shadowColor = "rgba(200, 136, 58, 0.5)";
      c.shadowBlur = 8;
      c.strokeStyle = "rgba(200, 136, 58, 0.9)";
      c.lineWidth = 1.5;
      c.lineJoin = "round";
      c.beginPath();
      let first = true;
      for (let i = 0; i < n; i += step) {
        const x = (i / n) * W;
        const y = (scopeData[i] / 128 - 1) * (H * 0.42) + H * 0.5;
        if (first) {
          c.moveTo(x, y);
          first = false;
        } else c.lineTo(x, y);
      }
      c.stroke();
      c.restore();
    } else {
      // Idle: faint centre line
      c.strokeStyle = "rgba(200, 136, 58, 0.14)";
      c.lineWidth = 1;
      c.beginPath();
      c.moveTo(0, H * 0.5);
      c.lineTo(W, H * 0.5);
      c.stroke();
    }
  }

  function startScopeLoop(): void {
    const loop = (): void => {
      drawScopeFrame();
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  // ── Fetch raw bytes at low priority (no AudioContext needed) ──
  async function prefetchRaw(url: string): Promise<void> {
    if (rawCache.has(url) || bufCache.has(url)) return;
    try {
      const res = await fetch(url, { priority: "low" } as RequestInit);
      if (!res.ok) return;
      rawCache.set(url, await res.arrayBuffer());
    } catch {}
  }

  // ── Get a decoded AudioBuffer, decoding from raw cache or fetching fresh ──
  async function getBuffer(url: string): Promise<AudioBuffer | null> {
    if (bufCache.has(url)) return bufCache.get(url)!;
    const ctx = getCtx();
    let raw = rawCache.get(url);
    if (!raw) {
      try {
        const res = await fetch(url);
        if (!res.ok) return null;
        raw = await res.arrayBuffer();
        rawCache.set(url, raw);
      } catch {
        return null;
      }
    }
    try {
      // .slice(0) clones the ArrayBuffer — decodeAudioData transfers (neuters) its arg
      const buf = await ctx.decodeAudioData(raw.slice(0));
      bufCache.set(url, buf);
      return buf;
    } catch {
      return null;
    }
  }

  // ── Play a decoded buffer through a simple gain node ──────────
  function playBuffer(buf: AudioBuffer, rate = 1.0): void {
    const ctx = getCtx();
    const src = ctx.createBufferSource();
    src.buffer = buf;
    src.playbackRate.value = rate;
    const gain = ctx.createGain();
    gain.gain.value = 0.85;
    src.connect(gain);
    gain.connect(getMixerGain("bowls"));
    src.start();
  }

  // ── Inharmonic synthesis — runs instantly if sample not ready ─
  function playSynth(freq: number): void {
    const ctx = getCtx();
    const now = ctx.currentTime;
    const dur = 9;

    const masterGain = ctx.createGain();
    const comp = ctx.createDynamicsCompressor();
    comp.threshold.value = -18;
    comp.knee.value = 10;
    comp.ratio.value = 6;
    comp.attack.value = 0.003;
    comp.release.value = 0.3;
    masterGain.gain.value = 0.78;
    masterGain.connect(comp);
    comp.connect(getMixerGain("bowls"));

    // Inharmonic partials characteristic of real singing bowls
    const partials: [number, number][] = [
      [1, 0.6],
      [2.756, 0.22],
      [5.404, 0.09],
      [8.933, 0.03],
    ];
    for (const [mult, amp] of partials) {
      const osc = ctx.createOscillator();
      const env = ctx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(freq * mult, now);
      osc.frequency.setTargetAtTime(freq * mult * 1.0008, now + 0.1, 2.5);
      env.gain.setValueAtTime(0, now);
      env.gain.linearRampToValueAtTime(amp, now + 0.045);
      env.gain.exponentialRampToValueAtTime(0.0001, now + dur);
      osc.connect(env);
      env.connect(masterGain);
      osc.start(now);
      osc.stop(now + dur + 0.1);
    }
  }

  // ── Gapless loop via lookahead crossfade scheduler ───────────
  // src.loop = true makes a hard cut at the loop boundary; any waveform
  // discontinuity (even with a WAV) causes a click. Instead we schedule
  // overlapping BufferSourceNodes with a short crossfade at each boundary.
  // setInterval is only for lookahead re-scheduling — all timing is on the
  // Web Audio clock, so JS-timer jitter (~50 ms) never touches the audio.
  const DRONE_GAIN = 0.8;
  const FADE_DUR = 4.0; // 4 s fade-out baked into the end of every recording
  const XFADE_DUR = 0.06; // 60 ms — synth drone / bansuri / chimes
  const TANPURA_XFADE = 2.0; // 2 s — long breathable crossfade for tanpura
  const NATURE_XFADE = 3.0; // 3 s — ambient nature loops
  const LOOKAHEAD = 3.0; // schedule this many seconds ahead of audio clock
  const SCHED_MS = 400; // how often to top up the schedule (ms)

  function startDroneLoop(
    buf: AudioBuffer,
    destination: AudioNode,
    rate = 1.0,
    xfade = XFADE_DUR,
  ): { stop: (fadeDur?: number) => void } {
    const ctx = getCtx();
    const loopDur = buf.duration / rate; // real-time length at this playback rate

    // Master: overall fade-in / fade-out envelope
    const master = ctx.createGain();
    master.gain.setValueAtTime(0, ctx.currentTime);
    master.gain.linearRampToValueAtTime(DRONE_GAIN, ctx.currentTime + 2);
    master.connect(destination);

    let stopped = false;
    let nextT = ctx.currentTime;
    const srcs: AudioBufferSourceNode[] = [];

    function fill(horizon: number): void {
      while (nextT < horizon) {
        const t = nextT;
        const src = ctx.createBufferSource();
        src.buffer = buf;
        src.playbackRate.value = rate;

        // Per-instance crossfade gain: ramp in, sustain, ramp out
        const g = ctx.createGain();
        g.gain.setValueAtTime(0, t);
        g.gain.linearRampToValueAtTime(1, t + xfade);
        g.gain.setValueAtTime(1, t + loopDur - xfade);
        g.gain.linearRampToValueAtTime(0, t + loopDur);

        src.connect(g);
        g.connect(master);
        src.start(t);
        src.stop(t + loopDur + 0.01); // slight tail so gain fully reaches 0
        srcs.push(src);

        // Next instance starts xfade before this one ends — they overlap
        nextT += loopDur - xfade;
      }
    }

    fill(ctx.currentTime + LOOKAHEAD);
    const ticker = setInterval(() => {
      if (stopped) return clearInterval(ticker);
      fill(ctx.currentTime + LOOKAHEAD);
    }, SCHED_MS);

    return {
      stop(fadeDur = 1.5) {
        stopped = true;
        clearInterval(ticker);
        const now = ctx.currentTime;
        master.gain.cancelScheduledValues(now);
        master.gain.setValueAtTime(master.gain.value || DRONE_GAIN, now);
        master.gain.linearRampToValueAtTime(0, now + fadeDur);
        srcs.forEach((s) => {
          try {
            s.stop(now + fadeDur + 0.1);
          } catch {}
        });
      },
    };
  }

  async function toggleDroneNote(
    btn: HTMLButtonElement,
    getCtrl: () => DroneCtrl,
    setCtrl: (c: DroneCtrl) => void,
    mixId: string,
    groupSel: string,
  ): Promise<void> {
    const src = btn.dataset.src ?? "";
    const rate = parseFloat(btn.dataset.rate ?? "1");
    const note = btn.dataset.note ?? "";

    const current = getCtrl();
    if (current) {
      const wasThisNote = current.note === note;
      current.stop(1.5);
      setCtrl(null);
      document.querySelectorAll<HTMLButtonElement>(groupSel).forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-pressed", "false");
      });
      if (wasThisNote) return;
    }

    if (!src) return;
    const buf = await getBuffer(src);
    if (!buf) return;

    setCtrl({
      note,
      rate,
      ...startDroneLoop(
        buf,
        getMixerGain(mixId),
        rate,
        mixId === "tanpura" ? TANPURA_XFADE : XFADE_DUR,
      ),
    });
    btn.classList.add("active");
    btn.setAttribute("aria-pressed", "true");
  }

  // ── Main: try real sample, fall back to synthesis ─────────────
  async function playBowl(btn: HTMLButtonElement): Promise<void> {
    const src = btn.dataset.src ?? "";
    const rate = parseFloat(btn.dataset.rate ?? "1");
    const freq = parseFloat(btn.dataset.freq ?? "256");
    if (src) {
      const buf = await getBuffer(src);
      if (buf) {
        playBuffer(buf, rate);
        return;
      }
    }
    playSynth(freq);
  }

  // ── Ripple animation ──────────────────────────────────────────
  function addRipple(btn: HTMLElement): void {
    const r1 = document.createElement("span");
    r1.className = "sb-ripple";
    const r2 = document.createElement("span");
    r2.className = "sb-ripple sb-ripple--2";
    btn.appendChild(r1);
    btn.appendChild(r2);
    r1.addEventListener("animationend", () => r1.remove(), { once: true });
    r2.addEventListener("animationend", () => r2.remove(), { once: true });
  }

  // ── Recorder (WAV) ────────────────────────────────────────────

  function formatRecDuration(ms: number): string {
    const s = Math.floor(ms / 1000);
    const m = Math.floor(s / 60);
    return `${String(m).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
  }

  // Encode mono Float32 PCM chunks → 16-bit WAV Blob
  function encodeWav(samples: Float32Array[], sampleRate: number): Blob {
    const totalLen = samples.reduce((n, a) => n + a.length, 0);
    const dataLen = totalLen * 2; // 16-bit = 2 bytes per sample
    const buf = new ArrayBuffer(44 + dataLen);
    const v = new DataView(buf);

    const str = (off: number, s: string) => {
      for (let i = 0; i < s.length; i++) v.setUint8(off + i, s.charCodeAt(i));
    };

    str(0, "RIFF");
    v.setUint32(4, 36 + dataLen, true);
    str(8, "WAVE");
    str(12, "fmt ");
    v.setUint32(16, 16, true);         // chunk size
    v.setUint16(20, 1, true);          // PCM format
    v.setUint16(22, 1, true);          // mono
    v.setUint32(24, sampleRate, true);
    v.setUint32(28, sampleRate * 2, true); // byteRate
    v.setUint16(32, 2, true);          // blockAlign
    v.setUint16(34, 16, true);         // bitsPerSample
    str(36, "data");
    v.setUint32(40, dataLen, true);

    let offset = 44;
    for (const chunk of samples) {
      for (let i = 0; i < chunk.length; i++) {
        const s = Math.max(-1, Math.min(1, chunk[i]));
        v.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7fff, true);
        offset += 2;
      }
    }

    return new Blob([buf], { type: "audio/wav" });
  }

  function startRecording(btn: HTMLButtonElement, textEl: HTMLElement): void {
    const ctx = getCtx();
    recSampleRate = ctx.sampleRate;
    recSamples = [];

    // Fade gain lets us ramp the recording to silence before saving
    recFadeGain = ctx.createGain();
    recFadeGain.gain.value = 1;

    // ScriptProcessorNode captures mono PCM from the analyser output.
    // Deprecated but universally supported; AudioWorklet would need a public worklet file.
    scriptProcessor = ctx.createScriptProcessor(4096, 1, 1);
    scriptProcessor.addEventListener("audioprocess", (e) => {
      // Copy the buffer — the underlying ArrayBuffer is recycled after the event
      recSamples.push(new Float32Array(e.inputBuffer.getChannelData(0)));
    });

    // Route: analyser → recFadeGain → scriptProcessor → silent sink
    const silent = ctx.createGain();
    silent.gain.value = 0;
    silent.connect(ctx.destination);
    getAnalyser(ctx).connect(recFadeGain);
    recFadeGain.connect(scriptProcessor);
    scriptProcessor.connect(silent);

    recStartTime = Date.now();
    btn.classList.add("sb-rec-btn--active");
    btn.setAttribute("aria-label", "Stop recording and download");
    btn.setAttribute("aria-pressed", "true");
    textEl.textContent = "00:00";

    recTimerInterval = setInterval(() => {
      textEl.textContent = formatRecDuration(Date.now() - recStartTime);
    }, 1000);
  }

  function stopRecording(btn: HTMLButtonElement, textEl: HTMLElement): void {
    if (recTimerInterval) {
      clearInterval(recTimerInterval);
      recTimerInterval = null;
    }

    // Snapshot and clear module-level refs so re-entrant calls are safe
    const proc = scriptProcessor;
    const fadeGain = recFadeGain;
    const analyser = analyserNode;
    scriptProcessor = null;
    recFadeGain = null;

    // Immediately update UI: pulsing dot stops, button shows "Saving…" and is locked
    btn.classList.remove("sb-rec-btn--active");
    btn.setAttribute("aria-pressed", "false");
    btn.setAttribute("aria-label", "Saving recording…");
    btn.disabled = true;
    textEl.textContent = "Saving…";

    // Ramp the recording chain to silence over FADE_DUR seconds
    if (fadeGain && audioCtx) {
      const now = audioCtx.currentTime;
      fadeGain.gain.setValueAtTime(fadeGain.gain.value, now);
      fadeGain.gain.linearRampToValueAtTime(0, now + FADE_DUR);
    }

    // After the fade, disconnect the capture graph, encode, and download
    setTimeout(() => {
      try { analyser?.disconnect(fadeGain!); } catch {}
      try { fadeGain?.disconnect(); } catch {}
      try { proc?.disconnect(); } catch {}

      if (recSamples.length > 0) {
        const blob = encodeWav(recSamples, recSampleRate);
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `sound-bath-${new Date().toISOString().slice(0, 19).replace(/:/g, "-")}.wav`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }
      recSamples = [];

      btn.disabled = false;
      btn.setAttribute("aria-label", "Start recording");
      textEl.textContent = "Rec";
    }, (FADE_DUR + 0.3) * 1000);
  }

  // ── Init ──────────────────────────────────────────────────────
  function initSoundBath(): void {
    // Splash screen: auto-dismiss after 4 s, or on click
    const splash = document.getElementById("sb-splash") as HTMLElement | null;
    if (splash) {
      const hideSplash = () => {
        splash.classList.add("sb-splash--hidden");
        splash.addEventListener("transitionend", () => splash.remove(), {
          once: true,
        });
      };
      setTimeout(hideSplash, 4000);
      splash.addEventListener("click", hideSplash, { once: true });
    }

    // Measure nav height so the console fills correctly below it
    const navEl = document.querySelector<HTMLElement>(".nav");
    if (navEl) {
      document.documentElement.style.setProperty(
        "--nav-h",
        navEl.offsetHeight + "px",
      );
    }

    // Tab switching
    document.querySelectorAll<HTMLButtonElement>(".sb-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        const panelId = tab.dataset.sbPanel ?? "";
        document.querySelectorAll<HTMLButtonElement>(".sb-tab").forEach((t) => {
          t.classList.remove("sb-tab--active");
          t.setAttribute("aria-selected", "false");
        });
        document.querySelectorAll<HTMLElement>(".sb-panel").forEach((p) => {
          p.hidden = true;
        });
        tab.classList.add("sb-tab--active");
        tab.setAttribute("aria-selected", "true");
        const panel = document.getElementById("sb-panel-" + panelId);
        if (panel) panel.hidden = false;
      });
    });

    // ── Mixer toggle ───────────────────────────────────────────────
    const consoleBody =
      document.querySelector<HTMLDivElement>(".sb-console-body");
    const mixToggleBtn = document.getElementById(
      "mix-toggle-btn",
    ) as HTMLButtonElement | null;
    const mixBackdrop = document.getElementById(
      "mix-backdrop",
    ) as HTMLDivElement | null;

    function setMixerOpen(open: boolean): void {
      consoleBody?.setAttribute("data-mixer-open", open ? "true" : "false");
      mixToggleBtn?.setAttribute("aria-expanded", open ? "true" : "false");
    }

    // On tablet and mobile, default to closed
    if (window.matchMedia("(max-width: 1024px)").matches) {
      setMixerOpen(false);
    }

    mixToggleBtn?.addEventListener("click", () => {
      const isOpen = consoleBody?.getAttribute("data-mixer-open") === "true";
      setMixerOpen(!isOpen);
    });
    mixBackdrop?.addEventListener("click", () => setMixerOpen(false));

    // ── Scope canvas setup ─────────────────────────────────────────
    const canvasEl = document.getElementById(
      "scope-canvas",
    ) as HTMLCanvasElement | null;
    if (canvasEl) {
      scopeCanvas = canvasEl;
      scopeCtx2d = canvasEl.getContext("2d");

      const resizeScopeCanvas = () => {
        const dpr = window.devicePixelRatio || 1;
        const w = canvasEl.offsetWidth;
        const h = canvasEl.offsetHeight;
        if (w === 0 || h === 0) return;
        canvasEl.width = w * dpr;
        canvasEl.height = h * dpr;
        // Scale is reset when canvas dimensions change, so re-apply
        if (scopeCtx2d) scopeCtx2d.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      resizeScopeCanvas();
      new ResizeObserver(resizeScopeCanvas).observe(canvasEl);
      startScopeLoop();
    }

    const bowls = document.querySelectorAll<HTMLButtonElement>(".sb-bowl");
    if (!bowls.length) return;

    bowls.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Visuals are instant; audio resolves async
        addRipple(btn);
        btn.classList.add("playing");
        clearTimeout((btn as any)._playTimer);
        (btn as any)._playTimer = setTimeout(
          () => btn.classList.remove("playing"),
          5500,
        );
        playBowl(btn);
      });
    });

    document
      .querySelectorAll<HTMLButtonElement>(
        ".sb-drone-note:not(.sb-drone-note--tanpura):not(.sb-drone-note--tanpura-ma)",
      )
      .forEach((btn) => {
        btn.addEventListener("click", () =>
          toggleDroneNote(
            btn,
            () => droneController,
            (c) => {
              droneController = c;
            },
            "drone",
            ".sb-drone-note:not(.sb-drone-note--tanpura):not(.sb-drone-note--tanpura-ma)",
          ),
        );
      });
    document
      .querySelectorAll<HTMLButtonElement>(".sb-drone-note--tanpura")
      .forEach((btn) => {
        btn.addEventListener("click", () =>
          toggleDroneNote(
            btn,
            () => tanpuraController,
            (c) => { tanpuraController = c; },
            "tanpura",
            ".sb-drone-note--tanpura",
          ),
        );
      });
    document
      .querySelectorAll<HTMLButtonElement>(".sb-drone-note--tanpura-ma")
      .forEach((btn) => {
        btn.addEventListener("click", () =>
          toggleDroneNote(
            btn,
            () => tanpuraMaController,
            (c) => { tanpuraMaController = c; },
            "tanpura",
            ".sb-drone-note--tanpura-ma",
          ),
        );
      });

    // ── Tanpura MA / PA toggle ────────────────────────────────
    const tanpuraToggle = document.getElementById("tanpura-toggle");
    const tanpuraPaRow  = document.getElementById("tanpura-pa-row");
    const tanpuraMaRow  = document.getElementById("tanpura-ma-row");

    const stopAllTanpuras = () => {
      tanpuraController?.stop(FADE_DUR);
      tanpuraController = null;
      tanpuraMaController?.stop(FADE_DUR);
      tanpuraMaController = null;
      document.querySelectorAll<HTMLButtonElement>(".sb-drone-note--tanpura, .sb-drone-note--tanpura-ma")
        .forEach((b) => { b.classList.remove("active"); b.setAttribute("aria-pressed", "false"); });
    };

    tanpuraToggle?.addEventListener("click", () => {
      const isMa = tanpuraToggle.getAttribute("aria-checked") === "true";
      stopAllTanpuras();
      if (isMa) {
        // Switch to PA
        tanpuraToggle.setAttribute("aria-checked", "false");
        tanpuraMaRow?.setAttribute("hidden", "");
        tanpuraPaRow?.removeAttribute("hidden");
      } else {
        // Switch to MA
        tanpuraToggle.setAttribute("aria-checked", "true");
        tanpuraPaRow?.setAttribute("hidden", "");
        tanpuraMaRow?.removeAttribute("hidden");
      }
    });
    tanpuraToggle?.addEventListener("keydown", (e) => {
      if (e.key === " " || e.key === "Enter") { e.preventDefault(); (tanpuraToggle as HTMLElement).click(); }
    });

    // Flute key selector
    document
      .querySelectorAll<HTMLButtonElement>(".sb-flute-key")
      .forEach((btn) => {
        btn.addEventListener("click", async () => {
          const rate = parseFloat(btn.dataset.rate ?? "1");
          const note = btn.dataset.note ?? "C";
          fluteKey = { note, rate };
          document
            .querySelectorAll<HTMLButtonElement>(".sb-flute-key")
            .forEach((b) => {
              b.classList.remove("active");
              b.setAttribute("aria-pressed", "false");
            });
          btn.classList.add("active");
          btn.setAttribute("aria-pressed", "true");
          // Re-pitch any currently-playing flute loops
          const activeFluteBtns = document.querySelectorAll<HTMLButtonElement>(
            '.bl-btn.active[data-mix-id="flute"]',
          );
          for (const fluteBtn of activeFluteBtns) {
            const fluteSrc = fluteBtn.dataset.src ?? "";
            if (!fluteSrc) continue;
            bansuriControllers.get(fluteSrc)?.stop(0.3);
            bansuriControllers.delete(fluteSrc);
            const fluteBuf = await getBuffer(fluteSrc);
            if (!fluteBuf) continue;
            bansuriControllers.set(
              fluteSrc,
              startDroneLoop(fluteBuf, getMixerGain("flute"), rate),
            );
          }
        });
      });

    // Bansuri loop toggles — each button independently controls its own loop
    document.querySelectorAll<HTMLButtonElement>(".bl-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const src = btn.dataset.src ?? "";
        if (!src) return;

        const existing = bansuriControllers.get(src);
        if (existing) {
          existing.stop(1.5);
          bansuriControllers.delete(src);
          btn.classList.remove("active");
          btn.setAttribute("aria-pressed", "false");
          return;
        }

        const buf = await getBuffer(src);
        if (!buf) return;

        const mixId = btn.dataset.mixId ?? src;
        // Flute loops use the independently-selected key; chimes and nature are unpitched
        const fluteRate = mixId === "flute" ? fluteKey.rate : 1;
        const xfade = mixId === "nature" ? NATURE_XFADE : XFADE_DUR;
        bansuriControllers.set(
          src,
          startDroneLoop(buf, getMixerGain(mixId), fluteRate, xfade),
        );
        btn.classList.add("active");
        btn.setAttribute("aria-pressed", "true");
      });
    });

    // Mixer fader events — update gain in real time; never create AudioContext on slider move
    document
      .querySelectorAll<HTMLInputElement>(".mix-fader")
      .forEach((slider) => {
        const id = slider.dataset.mixId ?? "";
        const valEl = document.getElementById("mix-" + id + "-val");
        slider.addEventListener("input", () => {
          if (valEl) valEl.textContent = slider.value;
          const existing = mixerGains.get(id);
          if (existing && audioCtx) {
            // setTargetAtTime for smooth gain change (avoids zipper noise)
            existing.gain.setTargetAtTime(
              parseFloat(slider.value) / 100,
              audioCtx.currentTime,
              0.016,
            );
          }
        });

        // Mousewheel nudge — scroll up = louder, step proportional to range
        const wheelStep = Math.max(1, Math.round(parseFloat(slider.max) / 20));
        slider.addEventListener("wheel", (e) => {
          e.preventDefault();
          const next = Math.min(
            parseFloat(slider.max),
            Math.max(0, parseFloat(slider.value) - Math.sign(e.deltaY) * wheelStep),
          );
          slider.value = String(next);
          slider.dispatchEvent(new Event("input", { bubbles: false }));
        }, { passive: false });
      });

    const doSilence = () => {
      // Start countdown on the button
      const silenceBtn = document.getElementById("sb-tab-silence") as HTMLButtonElement | null;
      const silenceIcon = silenceBtn?.querySelector<HTMLElement>(".sb-tab-silence__icon");
      const silenceText = silenceBtn?.querySelector<HTMLElement>(".sb-tab-silence__text");
      const silenceCountdown = silenceBtn?.querySelector<HTMLElement>(".sb-tab-silence__countdown");
      if (silenceBtn && silenceIcon && silenceText && silenceCountdown) {
        silenceBtn.disabled = true;
        silenceText.hidden = true;
        silenceCountdown.hidden = false;
        let remaining = Math.ceil(FADE_DUR);
        silenceCountdown.textContent = String(remaining);
        const tick = setInterval(() => {
          remaining -= 1;
          if (remaining <= 0) {
            clearInterval(tick);
            silenceCountdown.hidden = true;
            silenceText.hidden = false;
            silenceBtn.disabled = false;
          } else {
            silenceCountdown.textContent = String(remaining);
          }
        }, 1000);
      }

      // Fade all audio over 5 seconds
      droneController?.stop(FADE_DUR);
      droneController = null;
      tanpuraController?.stop(FADE_DUR);
      tanpuraController = null;
      tanpuraMaController?.stop(FADE_DUR);
      tanpuraMaController = null;
      bansuriControllers.forEach((ctrl) => ctrl.stop(FADE_DUR));
      bansuriControllers.clear();

      // Reset UI immediately so buttons look inactive right away
      document
        .querySelectorAll<HTMLButtonElement>(".sb-drone-note")
        .forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-pressed", "false");
        });
      document.querySelectorAll<HTMLButtonElement>(".bl-btn").forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-pressed", "false");
      });
      bowls.forEach((b) => {
        b.classList.remove("playing");
        clearTimeout((b as any)._playTimer);
      });

      // Stop recorder before closing the context
      const recBtnEl = document.getElementById(
        "sb-rec-btn",
      ) as HTMLButtonElement | null;
      const recTextEl = document.getElementById(
        "sb-rec-text",
      ) as HTMLElement | null;
      if (recBtnEl && recTextEl && (scriptProcessor || recFadeGain)) {
        stopRecording(recBtnEl, recTextEl);
      }

      // Close the AudioContext after the fade finishes
      setTimeout(
        () => {
          audioCtx?.close().then(() => {
            audioCtx = null;
            bufCache.clear();
            mixerGains.clear();
            analyserNode = null;
            scopeData = null;
          });
        },
        (FADE_DUR + 0.2) * 1000,
      );
    };
    document
      .getElementById("sb-tab-silence")
      ?.addEventListener("click", doSilence);

    // ── Recorder button ────────────────────────────────────────────
    const recBtn = document.getElementById(
      "sb-rec-btn",
    ) as HTMLButtonElement | null;
    const recText = document.getElementById(
      "sb-rec-text",
    ) as HTMLElement | null;
    if (recBtn && recText) {
      recBtn.addEventListener("click", () => {
        const isRecording = recBtn.getAttribute("aria-pressed") === "true";
        if (isRecording) {
          stopRecording(recBtn, recText);
        } else {
          startRecording(recBtn, recText);
        }
      });
    }

    // Pre-fetch all sample files when the browser is idle so first tap is instant
    const schedule =
      typeof requestIdleCallback !== "undefined"
        ? (fn: () => void) => requestIdleCallback(fn, { timeout: 4000 })
        : (fn: () => void) => setTimeout(fn, 1500);

    schedule(() => {
      // Single bowl file powers all pitched bowls
      prefetchRaw("/audio/soundbath/bowl-c.mp3");
      // Pre-fetch drone files (one file per instrument, all notes pitched via playbackRate)
      prefetchRaw("/audio/soundbath/drone-c.mp3");
      prefetchRaw("/audio/soundbath/tanpura-c.mp3");
      // Pre-fetch bansuri files
      document.querySelectorAll<HTMLButtonElement>(".bl-btn").forEach((btn) => {
        const src = btn.dataset.src;
        if (src) prefetchRaw(src);
      });
    });
  }

  document.addEventListener("astro:page-load", initSoundBath);
</script>
